{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ficha.json — fuente única de verdad de un proyecto",
  "type": "object",
  "required": ["version", "proyecto", "cliente", "tipologia", "requisitos", "diseno", "comercial", "estado"],
  "properties": {
    "version": {"const": 1},
    "proyecto": {"type": "object", "required": ["marca", "numero", "fecha", "validez_dias", "titulo"],
      "properties": {"marca": {"type": "string"}, "numero": {"type": "string"}, "fecha": {"type": "string", "format": "date"}, "validez_dias": {"type": "integer"}, "titulo": {"type": "string"}}},
    "cliente": {"type": "object", "required": ["localidad", "provincia"],
      "properties": {"nombre": {"type": ["string", "null"]}, "contacto": {"type": ["string", "null"]}, "localidad": {"type": "string"}, "provincia": {"type": "string"}, "zona_compras": {"type": ["string", "null"]}, "direccion_obra": {"type": ["string", "null"]}}},
    "tipologia": {"enum": ["portico-hamacas"]},
    "requisitos": {"type": "object", "required": ["uso", "configuraciones", "carga_diseno_kg", "factor_dinamico", "carga_por_puesto_kg", "espacio"],
      "properties": {
        "configuraciones": {"type": "array", "items": {"type": "object", "required": ["id", "nombre", "puestos"],
          "properties": {"puestos": {"type": "array", "items": {"enum": ["hamaca", "trapecio", "escalera", "cama"]}}}}},
        "espacio": {"type": "object", "required": ["largo_eje_travesano_m", "largo_vaiven_m"]}
      }},
    "diseno": {"type": "object", "description": "Medidas en mm. Claves: material, travesano, patas, tirante, cartela, varillas, arandela_ancha_mm, cuelgues, accesorios, apoyo, desperdicio_pct. Ver ejemplos/pueblo-andino/ficha.json."},
    "comercial": {"type": "object", "required": ["iva_pct", "mostrar_con_iva", "mod"],
      "properties": {"iva_pct": {"type": "number"}, "mostrar_con_iva": {"type": "boolean"}, "incluye_flete": {"const": false},
        "mod": {"type": "object", "properties": {"incluida": {"type": "boolean"}, "texto": {"type": "string"}}},
        "plazo_entrega": {"type": ["string", "null"]}, "garantia": {"type": ["string", "null"]}, "anexo_autoconstruccion": {"type": "boolean"}}},
    "estado": {"type": "object", "properties": {"validacion_aprobada": {"type": "boolean"}, "vueltas_auditoria": {"type": "integer"}}}
  }
}
