{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ficha.json — fuente única de verdad de un proyecto",
  "type": "object",
  "required": [
    "version",
    "proyecto",
    "cliente",
    "tipologia",
    "requisitos",
    "diseno",
    "comercial",
    "estado"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "proyecto": {
      "type": "object",
      "required": [
        "marca",
        "numero",
        "fecha",
        "validez_dias",
        "titulo"
      ],
      "properties": {
        "marca": {
          "type": "string"
        },
        "numero": {
          "type": "string"
        },
        "fecha": {
          "type": "string",
          "format": "date"
        },
        "validez_dias": {
          "type": "integer"
        },
        "titulo": {
          "type": "string"
        }
      }
    },
    "cliente": {
      "type": "object",
      "required": [
        "localidad",
        "provincia"
      ],
      "properties": {
        "nombre": {
          "type": [
            "string",
            "null"
          ]
        },
        "contacto": {
          "type": [
            "string",
            "null"
          ]
        },
        "localidad": {
          "type": "string"
        },
        "provincia": {
          "type": "string"
        },
        "zona_compras": {
          "type": [
            "string",
            "null"
          ]
        },
        "direccion_obra": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tipologia": {
      "enum": [
        "portico-hamacas",
        "jaula-cerdas",
        "estructura-libre"
      ],
      "description": "Define material base (madera o hierro), módulo del motor y si lleva presupuesto (catalogo/tipologias/<id>.json)."
    },
    "requisitos": {
      "type": "object",
      "description": "Requisitos del cliente; las claves dependen de la tipología (ver ejemplos/<tipologia>/ficha.json)."
    },
    "diseno": {
      "type": "object",
      "description": "Medidas en mm. Pórtico: material, travesano, patas, tirante, cartela, varillas, cuelgues, accesorios, apoyo (ejemplos/pueblo-andino). Jaula: box, tubos, largueros_z, parantes_x, puerta, frente, pie, comedero, caida, dosificador, rfid, previsiones, con _origen (fuente/criterio/supuesto) en cada bloque (ejemplos/jaula-cerdas)."
    },
    "comercial": {
      "type": "object",
      "required": [
        "iva_pct",
        "mostrar_con_iva",
        "mod"
      ],
      "properties": {
        "iva_pct": {
          "type": "number"
        },
        "mostrar_con_iva": {
          "type": "boolean"
        },
        "incluye_flete": {
          "const": false
        },
        "mod": {
          "type": "object",
          "properties": {
            "incluida": {
              "type": "boolean"
            },
            "texto": {
              "type": "string"
            }
          }
        },
        "plazo_entrega": {
          "type": [
            "string",
            "null"
          ]
        },
        "garantia": {
          "type": [
            "string",
            "null"
          ]
        },
        "anexo_autoconstruccion": {
          "type": "boolean"
        }
      }
    },
    "estado": {
      "type": "object",
      "properties": {
        "validacion_aprobada": {
          "type": "boolean"
        },
        "vueltas_auditoria": {
          "type": "integer"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipologia": {
            "const": "portico-hamacas"
          }
        }
      },
      "then": {
        "properties": {
          "requisitos": {
            "type": "object",
            "required": [
              "uso",
              "configuraciones",
              "carga_diseno_kg",
              "factor_dinamico",
              "carga_por_puesto_kg",
              "espacio"
            ],
            "properties": {
              "configuraciones": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "nombre",
                    "puestos"
                  ],
                  "properties": {
                    "puestos": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "hamaca",
                          "trapecio",
                          "escalera",
                          "cama"
                        ]
                      }
                    }
                  }
                }
              },
              "espacio": {
                "type": "object",
                "required": [
                  "largo_eje_travesano_m",
                  "largo_vaiven_m"
                ]
              },
              "superficie": {
                "enum": [
                  "al_ras",
                  "suelta",
                  null
                ],
                "description": "Superficie bajo las hamacas (EN 1176-2, 4.10.2): al_ras (césped, sintético) o suelta (arena, chips). Si falta, se usa suelta."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipologia": {
            "const": "jaula-cerdas"
          }
        }
      },
      "then": {
        "properties": {
          "requisitos": {
            "type": "object",
            "required": [
              "uso",
              "galpon",
              "linea_alimento"
            ],
            "properties": {
              "galpon": {
                "type": "object",
                "required": [
                  "slat"
                ]
              },
              "linea_alimento": {
                "type": "object",
                "required": [
                  "z",
                  "diam"
                ]
              },
              "cantidad_boxes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "diseno": {
            "type": "object",
            "required": [
              "box",
              "tubos",
              "largueros_z",
              "parantes_x",
              "puerta",
              "frente",
              "pie",
              "comedero",
              "caida",
              "dosificador",
              "rfid"
            ],
            "properties": {
              "pie": {
                "type": "object",
                "required": [
                  "pletina",
                  "m10_y",
                  "m12_y"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipologia": {
            "const": "estructura-libre"
          }
        }
      },
      "then": {
        "properties": {
          "requisitos": {
            "type": "object",
            "required": [
              "uso",
              "tipo_uso"
            ],
            "properties": {
              "tipo_uso": {
                "type": "string",
                "description": "mesa, banco o estante tienen cargas en el catálogo; cualquier otro uso necesita requisitos.cargas completo."
              },
              "cantidad": {
                "type": "integer",
                "minimum": 1
              },
              "exterior": {
                "type": "boolean"
              },
              "medidas": {
                "type": "object",
                "properties": {
                  "largo": {
                    "type": "number"
                  },
                  "ancho": {
                    "type": "number"
                  },
                  "alto": {
                    "type": "number"
                  }
                },
                "description": "Medidas totales pedidas (mm); el motor verifica que el diseño las respete."
              },
              "cargas": {
                "type": "object",
                "properties": {
                  "distribuida_kg_m2": {
                    "type": "number",
                    "minimum": 0
                  },
                  "puntual_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "empuje_lateral_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "carga_borde_kg": {
                    "type": "number",
                    "minimum": 0
                  },
                  "empuje_vuelco_kg": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "referencia": {
                "type": "object",
                "properties": {
                  "origen": {
                    "type": "string"
                  },
                  "descripcion": {
                    "type": "string"
                  },
                  "tomado": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cambiado": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "description": "Qué se tomó de la foto o del pedido y qué se cambió y por qué. Las medidas nunca salen de la foto."
              }
            }
          },
          "diseno": {
            "type": "object",
            "required": [
              "secciones",
              "barras",
              "placas"
            ],
            "properties": {
              "secciones": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "tipo"
                  ],
                  "properties": {
                    "tipo": {
                      "enum": [
                        "tubo-rect",
                        "tubo-redondo",
                        "madera",
                        "planchuela"
                      ]
                    },
                    "b": {
                      "type": "number",
                      "description": "ancho horizontal (mm)"
                    },
                    "h": {
                      "type": "number",
                      "description": "alto (mm); en vigas va vertical"
                    },
                    "esp": {
                      "type": "number"
                    },
                    "diam": {
                      "type": "number"
                    },
                    "material": {
                      "type": "string",
                      "description": "solo madera: id de catalogo/materiales.json → maderas_aserradas"
                    },
                    "acabado": {
                      "type": "string",
                      "description": "negro, galvanizado, inox, blanco… (define el color del 3D y la verificación de exterior)"
                    }
                  }
                }
              },
              "barras": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "seccion",
                    "a",
                    "b"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "nombre": {
                      "type": "string"
                    },
                    "seccion": {
                      "type": "string"
                    },
                    "a": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "b": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rol": {
                      "enum": [
                        "pata",
                        "viga",
                        "riostra"
                      ]
                    },
                    "grupo": {
                      "type": "string"
                    },
                    "corte": {
                      "type": "string",
                      "description": "recto (por defecto), a 45°…"
                    },
                    "ancho_carga": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "mm de superficie que carga directo la barra (tablas de asiento, listones)"
                    }
                  }
                }
              },
              "placas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "material",
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "nombre": {
                      "type": "string"
                    },
                    "material": {
                      "type": "string",
                      "description": "id de catalogo/materiales.json → tableros"
                    },
                    "x": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "y": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "z": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "acabado": {
                      "type": "string"
                    },
                    "fijacion": {
                      "type": "string"
                    },
                    "grupo": {
                      "type": "string"
                    },
                    "veta": {
                      "enum": [
                        "x",
                        "y"
                      ],
                      "description": "dirección de los listones o tablas: la placa trabaja a lo largo de la veta"
                    }
                  }
                }
              },
              "insumos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "descripcion",
                    "cant",
                    "unidad"
                  ]
                }
              },
              "uniones": {
                "type": "string"
              },
              "terminacion": {
                "type": "string"
              },
              "pendientes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}